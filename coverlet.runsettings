<?xml version="1.0" encoding="utf-8"?>
<!-- Settings for code coverage (Coverlet). Used with: dotnet test -s coverlet.runsettings -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <!-- Only the backend is measured. The Blazor frontend has no automated tests. -->
          <Include>[Tickecheck.Domain]*,[Tickecheck.Application]*,[Tickecheck.Infrastructure]*,[Tickecheck.Api]*</Include>
          <!-- Migrations are generated by EF Core; counting them would distort the number. -->
          <ExcludeByFile>**/Migrations/*.cs</ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
