# Copy this file to ".env" and adjust the values. ".env" is ignored by git.

# SQL Server requires at least 8 characters with upper case, lower case, digits and symbols.
MSSQL_SA_PASSWORD=Local_Dev_Passw0rd!

# Change it if you already have a SQL Server listening on 1433.
MSSQL_PORT=1433

# Secret used to sign the JWTs when the API runs in Docker. At least 32 characters.
JWT_SIGNING_KEY=local-docker-signing-key-change-me-0123456789
